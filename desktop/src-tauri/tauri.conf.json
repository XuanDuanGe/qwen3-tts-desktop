{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qwen3 TTS Desktop",
  "version": "0.1.0",
  "identifier": "com.qwen3.tts.desktop",
  "build": {
    "beforeDevCommand": "..\\scripts\\pnpm-msvc.cmd dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "..\\scripts\\pnpm-msvc.cmd build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qwen3 TTS Desktop",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
